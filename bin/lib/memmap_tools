#!/usr/bin/env bash
# Shared utilities sourced by bin/memmap and bin/memclean. Read-only: nothing here kills.

# mem_snapshot OUT
# Writes one TSV line per process: PID PPID KB ETIME OWNER KIND ARGS
# KB is top's MEM column, the footprint Activity Monitor shows (ps RSS is not).
# OWNER is what the process counts toward overall: its outermost .app bundle,
# the VM, or its executable name. KIND is its dev category, "-" when it has none.
mem_snapshot() {
  local work colima=0
  work="$(mktemp -d)"
  pgrep -qf 'colima daemon' && colima=1
  top -l 1 -stats pid,mem > "$work/top"
  ps -axo pid=,ppid=,etime=,comm= > "$work/comm"
  ps -axo pid=,args= > "$work/args"
  awk -v colima="$colima" '
    function kb(m,   n, u) {
      n = m + 0; u = m; gsub(/[0-9.+-]/, "", u)
      return u == "G" ? n * 1048576 : u == "M" ? n * 1024 : u == "K" ? n : n / 1024
    }
    function base(p) { sub(/.*\//, "", p); return p }
    function kind(comm, b) {
      if (comm ~ /Virtualization\.VirtualMachine/) return "vm"
      if (comm ~ /CoreSimulator/)                  return "simulator"
      if (comm ~ /\.app\//)                        return "-"
      if (b ~ /^(node|bun|deno|npm|npx|pnpm|yarn|next-server|vite|tsx)( |$)/) return "node"
      if (b ~ /^(python[0-9.]*|uv|uvicorn|gunicorn|celery)$/) return "python"
      if (b ~ /^(ruby|puma|sidekiq|rails)( |:|$)/)          return "ruby"
      if (b ~ /^(beam\.smp|erl|elixir|epmd)$/)               return "beam"
      if (b ~ /^java$/)                                     return "java"
      if (b ~ /^(postgres|postmaster|redis-server|mysqld|mongod)( |:|$)/) return "database"
      if (b ~ /language-server|^(gopls|rust-analyzer|tsserver|sourcekit-lsp|clangd)$/) return "lsp"
      if (b ~ /^claude$/)                                   return "claude"
      return "-"
    }
    FILENAME ~ /top$/ {
      if ($1 == "PID") { body = 1; next }
      if (body && $1 ~ /^[0-9]+$/) mem[$1] = kb($2)
      next
    }
    FILENAME ~ /args$/ {
      p = $1; sub(/^ *[0-9]+ /, ""); args[p] = $0; next
    }
    {
      p = $1; pp = $2; et = $3
      comm = $0; sub(/^ *[0-9]+ +[0-9]+ +[^ ]+ /, "", comm)
      b = base(comm); k = kind(comm, b)
      if (k == "vm") owner = colima ? "colima VM" : "Virtualization VM"
      else if (match(comm, /[^\/]+\.app\//)) owner = substr(comm, RSTART, RLENGTH - 5)
      else owner = b
      head[p] = p "\t" pp; tail[p] = et "\t" owner "\t" k
      order[++n] = p
    }
    END {
      for (i = 1; i <= n; i++) {
        p = order[i]
        printf "%s\t%d\t%s\t%s\n", head[p], mem[p], tail[p], args[p]
      }
    }
  ' "$work/top" "$work/args" "$work/comm" > "$1"
  rm -rf "$work"
}

# mem_units SNAPSHOT
# Folds each dev process into its nearest ancestor of the same KIND, so a tree
# like npm -> node -> next-server is one unit. One TSV line per unit, largest first:
# KIND KB COUNT ROOT_PID ETIME PIDS(comma, children first) ARGS(root)
mem_units() {
  awk -F'\t' '
    { pp[$1] = $2; kb[$1] = $3; et[$1] = $4; k[$1] = $6; args[$1] = $7; order[++n] = $1 }
    END {
      for (i = n; i >= 1; i--) {
        p = order[i]; if (k[p] == "-") continue
        r = p
        while ((pp[r] in k) && k[pp[r]] == k[p]) r = pp[r]
        sum[r] += kb[p]; cnt[r]++
        pids[r] = (r in pids) ? pids[r] "," p : p
      }
      for (r in sum)
        printf "%s\t%d\t%d\t%s\t%s\t%s\t%s\n", k[r], sum[r], cnt[r], r, et[r], pids[r], args[r]
    }
  ' "$1" | sort -t$'\t' -k2,2nr
}

# mem_owners SNAPSHOT -> OWNER KB COUNT per owner, largest first.
mem_owners() {
  awk -F'\t' '{ s[$5] += $3; c[$5]++ } END { for (o in s) printf "%s\t%d\t%d\n", o, s[o], c[o] }' "$1" \
    | sort -t$'\t' -k2,2nr
}

# mem_containers -> PROJECT KB COUNT IDS(space) per running container group, largest first.
# Silent when docker is absent or its daemon is unreachable.
mem_containers() {
  command -v docker >/dev/null || return 0
  docker info >/dev/null 2>&1 || return 0
  {
    docker ps --format '{{.ID}}	{{.Label "com.docker.compose.project"}}	{{.Label "com.supabase.cli.project"}}	{{.Names}}'
    echo "--"
    docker stats --no-stream --format '{{.ID}}	{{.MemUsage}}'
  } | awk -F'\t' '
    function kb(m,   n, u) {
      sub(/ \/.*/, "", m); n = m + 0; u = m; gsub(/[0-9.]/, "", u)
      return u ~ /^G/ ? n * 1048576 : u ~ /^M/ ? n * 1024 : u ~ /^k/ ? n : n / 1024
    }
    $0 == "--" { stats = 1; next }
    !stats { proj[$1] = $2 != "" ? $2 : $3 != "" ? "supabase " $3 : $4; next }
    ($1 in proj) { p = proj[$1]; s[p] += kb($2); c[p]++; ids[p] = ids[p] (ids[p] ? " " : "") $1 }
    END { for (p in s) printf "%s\t%d\t%d\t%s\n", p, s[p], c[p], ids[p] }
  ' | sort -t$'\t' -k2,2nr
}

# human_kb KB -> "1.2 GB", or MB below 1 GB.
human_kb() {
  awk -v k="$1" 'BEGIN { if (k >= 1048576) printf "%.1f GB", k / 1048576; else printf "%d MB", k / 1024 }'
}
