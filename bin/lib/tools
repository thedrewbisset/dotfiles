#!/usr/bin/env bash
function handle_conflicting {
  target_path=$1
  echo "Found conflicting file: '$target_path'"
  select action in "Overwrite" "Skip"; do
    case "$action" in
      Overwrite)
        remove $target_path; break;;
      Skip)
        return 1;;
      *)
        echo "Invalid option"
    esac
  done
}

function remove {
  rm -rf $1
  echo "Removed $1"
}

function set_link {
  source_path=$1
  target_path=$2

  # Refuse to link a path onto itself. This happens when the target's parent
  # directory is a symlink back into the source tree (e.g. ~/.claude ->
  # source/.claude), which would otherwise create a self-referential,
  # unreadable symlink. Resolve via the parent dir so it works even when the
  # target doesn't exist yet or is already a broken self-link.
  target_parent="$(cd "$(dirname "$target_path")" 2>/dev/null && pwd -P)"
  source_resolved="$(cd "$(dirname "$source_path")" 2>/dev/null && pwd -P)/$(basename "$source_path")"
  if [ -n "$target_parent" ] && [ "$target_parent/$(basename "$target_path")" = "$source_resolved" ]; then
    echo "Skipping $target_path (already in place; resolves to source)"
    return 0
  fi

  if [ -e $target_path ] || [ -L $target_path ]; then
    if handle_conflicting $target_path; then
      ln -s $source_path $target_path
      printf "Symlinked $target_path \xE2\x9E\x94 $source_path\n"
    else
      echo "Skipping $target_path"
    fi
  else
    echo "Linking $target_path to $source_path"
    ln -s $source_path $target_path
  fi
}

# Warn when a git include target is missing.
#
# .gitconfig selects an identity per directory via includeIf. If the target file
# does not exist, git SILENTLY ignores the include and falls back to the default
# [user] -- no warning, and nothing in `git config` output to show it happened.
# The first symptom is usually a commit authored under the wrong name, or a push
# authenticating as the wrong account because core.sshCommand lived in the same
# missing file. Both are discovered too late.
#
# Deliberately warns rather than creating the file from its .example: a template
# supplies placeholder values, and a working identity reading "<github-username>"
# is worse than no identity at all.
function check_git_includes {
  local gitconfig="${TARGET_HOME:-$HOME}/.gitconfig"
  local dotfiles_dir="${1:-$PWD}"
  local missing=()

  [ -r "$gitconfig" ] || return 0

  local raw path
  while IFS= read -r raw; do
    path="${raw#*=}"
    path="${path#"${path%%[![:space:]]*}"}"
    path="${path%"${path##*[![:space:]]}"}"
    [ -n "$path" ] || continue
    case "$path" in
      "~"*) path="${TARGET_HOME:-$HOME}${path#\~}" ;;
    esac
    if [ ! -e "$path" ]; then
      case " ${missing[*]} " in
        *" $path "*) ;;
        *) missing+=("$path") ;;
      esac
    fi
  done < <(grep -E '^[[:space:]]*path[[:space:]]*=' "$gitconfig" 2>/dev/null)

  [ ${#missing[@]} -eq 0 ] && return 0

  echo ""
  echo "=============================================================="
  echo "WARNING: git identity files referenced by .gitconfig are missing"
  echo "=============================================================="
  local m base
  for m in "${missing[@]}"; do
    base="$(basename "$m")"
    echo ""
    echo "  $m"
    echo "    Git ignores this include silently. Commits in the directories"
    echo "    it covers will use the DEFAULT identity, and pushes may"
    echo "    authenticate as the wrong account."
    if [ -f "$dotfiles_dir/source/$base.example" ]; then
      echo "    Fix: cp source/$base.example source/$base"
      echo "         \$EDITOR source/$base   # then re-run this recipe"
    else
      echo "    Fix: create $m with the identity it should supply."
    fi
  done
  echo ""
  echo "=============================================================="
  echo ""
  return 1
}
