#!/usr/bin/env bash
set -e

# Claude Code CLI installation only.
#
# This recipe no longer manages ~/.claude. Agent configuration -- CLAUDE.md,
# rules, skills, settings and the status line -- is version-controlled in its own
# repository with its own installer, and is symlinked into ~/.claude from there.
#
# It used to symlink those files out of source/.claude/. It stopped because two
# installers managing the same paths meant re-running this recipe silently
# reverted the other one's work. source/.claude/ has since been removed.
#
# ~/.claude must remain a REAL directory. It is Claude Code's live home and holds
# runtime state (sessions, history, projects) that must never enter a repository.
# recipes/dotfiles skips it for the same reason.

claude_target="${TARGET_HOME:-$HOME}/.claude"

if [ -L "$claude_target" ]; then
  echo "ERROR: $claude_target is a symlink -> $(readlink "$claude_target")" >&2
  echo "It must be a real directory so Claude's runtime state stays out of any repo." >&2
  return 1 2>/dev/null || exit 1
fi

if ! command -v claude &>/dev/null; then
  echo ""
  read -r -p "Install Claude Code CLI? (Anthropic's native installer) [y/N] " _claude_response
  if [[ "$_claude_response" =~ ^[Yy]$ ]]; then
    echo "Installing Claude Code CLI..."
    curl -fsSL https://claude.ai/install.sh | sh
  else
    echo "Skipping Claude Code CLI installation."
  fi
  unset _claude_response
else
  echo "Claude Code CLI already installed ($(claude --version 2>/dev/null || echo 'version unknown'))"
fi

echo "Agent configuration is managed outside this repo; nothing linked here."
