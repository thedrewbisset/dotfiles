#!/usr/bin/env bash
set -e

source "$PWD/recipes/uv/install"

# Only tools that never import project code belong here: each uv tool runs in
# its own environment, so it cannot see a project's packages or Python. pytest,
# ipython and the like are per-project dev dependencies instead (uv add --dev).
PYTHON_TOOLS=(ruff)

for tool in "${PYTHON_TOOLS[@]}"; do
  uv tool install --python "$UV_PYTHON_VERSION" "$tool"
done

echo "Python setup complete (tools: ${PYTHON_TOOLS[*]})"
