#!/usr/bin/env bash

# Undoes recipes/python and the Python recipes/uv installs. Leaves uv itself
# (Homebrew owns it) and project .venvs alone.
PYTHON_TOOLS=(ruff poetry==2.1.1)
UV_PYTHON_VERSION="3.14"

echo "Tearing down uv-managed Python..."

if ! command -v uv &> /dev/null; then
  echo "uv not found — nothing to remove"
  exit 0
fi

for spec in "${PYTHON_TOOLS[@]}"; do
  tool="${spec%%==*}"
  if uv tool list 2>/dev/null | grep -q "^${tool} "; then
    uv tool uninstall "$tool"
    echo "Removed uv tool: $tool"
  else
    echo "uv tool not installed, skipping: $tool"
  fi
done

if uv python find --managed-python "$UV_PYTHON_VERSION" &> /dev/null; then
  uv python uninstall "$UV_PYTHON_VERSION"
  echo "Removed uv-managed Python $UV_PYTHON_VERSION"
else
  echo "uv-managed Python $UV_PYTHON_VERSION not installed, skipping"
fi
