Include ~/.colima/ssh_config

# personal account
Host github.com-tdb
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github.com-tdb

# work account
Host github.com-chartpro
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/chartpro

# business account
Host github.com-lge
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github.com-lge
