# UseKeychain is Apple's. Without this line Windows' OpenSSH does not skip it, it
# refuses the whole file -- "terminating, 3 bad configuration options" -- which takes
# every ssh and git-over-ssh command with it. Must stay first: IgnoreUnknown only
# covers options read after it. No effect on macOS, where UseKeychain is known.
IgnoreUnknown UseKeychain

Include ~/.colima/ssh_config
# Machine-specific hosts (LAN machines, IPs, usernames) live in an untracked local
# file, since this config is public. ssh skips the Include if the file is absent.
Include ~/.ssh/config.local

# The default key for github.com itself, for any remote that does not use one of the
# aliases below. This used to be core.sshCommand in .gitconfig, which forced the
# personal key onto every git ssh command -- including clones from the work and
# business aliases, since a command-line -i overrides the IdentityFile they set here.
Host github.com
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github.com-tdb

# personal account
Host github.com-tdb
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github.com-tdb

# work account
Host github.com-chartpro
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/chartpro

# business account
Host github.com-lge
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github.com-lge
