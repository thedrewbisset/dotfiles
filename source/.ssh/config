Include ~/.colima/ssh_config
# Machine-specific hosts (LAN machines, IPs, usernames) live in an untracked local
# file, since this config is public. ssh skips the Include if the file is absent.
Include ~/.ssh/config.local

# personal account
Host github.com-tdb
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github.com-tdb

# work account
Host github.com-chartpro
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/chartpro

# business account
Host github.com-lge
  HostName github.com
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github.com-lge
