# REQUIRED, not optional. .gitconfig includes this file by path. If it does
# not exist, git ignores the include SILENTLY -- no warning, and nothing in
# `git config` output to show it happened. Commits fall back to the default
# identity and pushes may authenticate as the wrong account.
#
# Per-directory git identity, selected by an includeIf rule in .gitconfig.
#
# Copy to .gitconfig-lge (without .example) and fill in. The real file is
# gitignored: a working identity has to hold a real name and address, and this
# repository is public.

[user]
  name = <github-username>
  email = <email>

[core]
  sshCommand = ssh -i ~/.ssh/<key-name> -o IdentitiesOnly=yes
